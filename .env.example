# ============================================================
# RAVP Platform — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# NEVER use placeholder values in production.
# ============================================================

# PostgreSQL Database (Neon or any PostgreSQL provider)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# Better Auth
# ============================================================
# REQUIRED: Must be a long random secret (min 32 chars).
# Generate on Linux/Mac: openssl rand -base64 48
# Generate on Windows (PowerShell): $bytes = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"

# The canonical URL of your application (no trailing slash)
BETTER_AUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ============================================================
# Admin JWT Secret
# ============================================================
# REQUIRED: Must be a long random secret (min 32 chars).
# Generate on Linux/Mac: openssl rand -base64 48
# Generate on Windows (PowerShell): $bytes = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# NEVER use a predictable value or the default placeholder.
ADMIN_JWT_SECRET="replace-with-another-long-random-secret-min-32-chars"

# ============================================================
# Razorpay
# ============================================================
# Key ID is safe to expose to frontend (used in checkout)
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"

# Key Secret is SERVER-SIDE ONLY — NEVER expose to browser
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"

# Webhook Secret — for verifying Razorpay webhook payloads
# Set this in your Razorpay dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# ============================================================
# Resend (Email)
# ============================================================
# SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXX"

# From address for outgoing emails
EMAIL_FROM="RAVP <noreply@yourdomain.com>"

# ============================================================
# SMTP (Fallback email — optional if using Resend only)
# ============================================================
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT="465"
SMTP_USER="info@yourdomain.com"
SMTP_PASS="replace-with-smtp-password"

# ============================================================
# Node Environment
# ============================================================
NODE_ENV="production"
